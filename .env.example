# Copy to .env and fill in locally. Never commit real values.
# Production values live in Netlify / Supabase / GitHub secret stores.

# Postgres connection used by migrations and the worker.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gencut

# Outreach safety switch. Live email sending stays off unless explicitly enabled.
GENCUT_LIVE_EMAIL_SENDING=false

# Model providers (needed from milestone M3).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Image generation for the Film Crew (Google AI Studio key). Optional model override,
# e.g. GENCUT_IMAGE_MODEL=google:gemini-nano-banana-2.1
GEMINI_API_KEY=
GENCUT_IMAGE_MODEL=

# WhatsApp assistant for agents (Meta WhatsApp Cloud API). The assistant is off
# until the first four are set. Never commit values.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# The business number agents message, digits with country code (shown on Profile).
WHATSAPP_DISPLAY_NUMBER=
